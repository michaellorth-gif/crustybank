# Database (SQLite - file path, will be created automatically)
DATABASE_PATH=./data/app.db

# JWT Secret - Generate a secure random string
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# OpenAI API Key (optional - for AI chat feature)
OPENAI_API_KEY=sk-your-openai-api-key

# Server
PORT=5000

# --- Deployment (see docs/deployment.md) ---
# Set to 1 when running behind a hosting provider's proxy (Railway/Render)
# so rate limiting sees real client addresses.
TRUST_PROXY=
# Set to true AFTER the firm's accounts are created to block public signups.
DISABLE_REGISTRATION=
